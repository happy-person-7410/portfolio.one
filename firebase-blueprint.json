      "description": "Package pricing plans"
    },
    "/addOns/{addOnId}": {
      "schema": "AddOn",
      "description": "Optional add-on services"
    },
    "/testimonials/{testimonialId}": {
      "schema": "Testimonial",
      "description": "Client reviews and testimonials"
    },
    "/faqs/{faqId}": {
      "schema": "FaqItem",
      "description": "FAQ questions and answers"
