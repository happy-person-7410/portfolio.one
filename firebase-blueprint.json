  "firestore": {
    "/siteSettings/{id}": {
      "schema": "SiteSettings",
      "description": "Global studio settings documents"
    },
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Portfolio projects showcase documents"
    },
    "/projectImages/{imageId}": {
      "schema": "ProjectImage",
      "description": "Images and gallery screenshots for projects"
    },
    "/projectFeatures/{featureId}": {
      "schema": "ProjectFeature",
      "description": "Project feature bullets"
    },
    "/creativeWorks/{workId}": {
      "schema": "CreativeWork",
      "description": "Creative design and AI artwork items"
    },
    "/services/{serviceId}": {
      "schema": "Service",
      "description": "Studio service offerings"
    },
    "/pricingPlans/{planId}": {
