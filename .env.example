# Neon PostgreSQL Database Connection String
# Example: postgresql://happyperson_owner:abc123xyz@ep-sparkling-wave-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=your_neon_postgresql_connection_string

# Admin Authentication Secret (Used to sign and verify secure admin JWT tokens)
ADMIN_JWT_SECRET=your_secure_random_jwt_secret_min_32_characters

# Default Admin Credentials (Used only on initial database setup/migration if no admin exists)
ADMIN_DEFAULT_EMAIL=happyperson7410@gmail.com
ADMIN_DEFAULT_PASSWORD=ChangeThisStrongPassword123!
