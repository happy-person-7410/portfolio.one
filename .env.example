# Firebase Configuration
# Replace these with your Firebase project settings (also automatically bundled from firebase-applet-config.json)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=portfolio-58191.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=portfolio-58191
VITE_FIREBASE_STORAGE_BUCKET=portfolio-58191.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_FIRESTORE_DATABASE_ID=(default)
# Optional: Google Analytics 4 Measurement ID (format: G-XXXXXXXXXX)
VITE_FIREBASE_MEASUREMENT_ID=

# Designated Admin Email
VITE_ADMIN_EMAIL=admin@happyperson.studio
