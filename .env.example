# ==============================================================================
# Neon PostgreSQL Database Configuration (Server-Side Only)
#
# CRITICAL SECURITY RULES:
# 1. Never prefix with VITE_ to ensure the database URL is never exposed to the client.
# 2. Add your actual Neon connection string in .env (which is ignored by git).
# ==============================================================================
DATABASE_URL=

# ==============================================================================
# Administrator & Authentication Settings (Server-Side Only)
#
# ADMIN_EMAIL: Any user registering or logging in with this email is granted
# the 'admin' role. If left blank, defaults to happyperson7410@gmail.com.
# In addition, the first registered user is automatically granted 'admin'.
#
# ADMIN_SETUP_KEY (Optional): Secret key used to promote accounts via API.
# SESSION_SECRET: Secret salt used for signing session cookies.
# ==============================================================================
ADMIN_EMAIL=
ADMIN_SETUP_KEY=
SESSION_SECRET=

# Server runtime port & dev settings
PORT=3000
DISABLE_HMR=true
